generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  password      String // bcrypt hash
  role          String        @default("user") // "user" | "admin" | "developer"
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  chatSessions  ChatSession[]
  userMemories  UserMemory[]
  detailsAssigned    Enquiry[] @relation("DetailsAssignee")
  costAssigned       Enquiry[] @relation("CostAssignee")
  validationAssigned Enquiry[] @relation("ValidationAssignee")
  sendAssigned       Enquiry[] @relation("SendAssignee")
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory    String
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  messages  Json     @default("[]") // serialized UIMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id String @id @default(cuid())

  docketNumber       String   @unique
  partyName          String
  contractNo         String[] @default([])
  selectedContractNo String[] @default([])
  enquiryDate        DateTime

  enquiryType         String?
  state               String?
  paymentTerms        String?
  inspection          String?
  pbg                 String?
  utility             String?
  vaPercent           Float?
  orderStatus         String?
  closureStatus       String?
  projectReference    String?
  apm                 String?
  offerPdfGeneratedAt DateTime?
  offerPdfGeneratedBy String?
  senderEmail String?
  emailAddress        String?
  contactNo           String?
  duplicate String?
  duplicateOfDocket String?
  sourceThreadId String? @unique
  emailApproved    Boolean   @default(false)
  emailSentBy      String?
  // A quoted rate changed after the offer was sent; cleared by the next send.
  offerRevised     Boolean   @default(false)
  technicalEvaluation String?
  reverseAuctionStatus String?

  // Per-docket owner of each stage (Details, Cost, Validation, Send).
  detailsAssigneeId    String?
  detailsAssignee      User?   @relation("DetailsAssignee", fields: [detailsAssigneeId], references: [id], onDelete: SetNull)
  costAssigneeId       String?
  costAssignee         User?   @relation("CostAssignee", fields: [costAssigneeId], references: [id], onDelete: SetNull)
  validationAssigneeId String?
  validationAssignee   User?   @relation("ValidationAssignee", fields: [validationAssigneeId], references: [id], onDelete: SetNull)
  sendAssigneeId       String?
  sendAssignee         User?   @relation("SendAssignee", fields: [sendAssigneeId], references: [id], onDelete: SetNull)

  attachments Attachment[]
  items       EnquiryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Who changed VA% / quoted rate / validation, and when. No FK: survives item deletion.
model ItemChangeLog {
  id        String   @id @default(cuid())
  itemId    String
  enquiryId String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  createdAt DateTime @default(now())

  @@index([itemId])
}

model Attachment {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnquiryItem {
  id String @id @default(cuid())

  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  itemName String
  quantity Decimal

  itemType             String?
  moc                  String?
  itemTypeSource       String?
  mocSource            String?
  size                 String?
  sizeAndHeight        String?
  pnRating             String?
  erpItemCode          String?
  operationType        String?
  extension            String?
  bypass               String?
  others               String[] @default([])
  productCost          Decimal?
  costRefCode          String?
  cost                 Decimal?
  stockStatus          String?
  discount             Decimal?
  vaPercent            String?
  quotedRate           String?
  bomId                String?
  bomType              String? //(stores "DIRECT M2M")
  rmItemCode           String? //(the CONSUMPTION-1 rm code, for traceability)
  rmType               String?  @default("COMMON")
  contractReviewRate   String?
  pdcostValidation     String?
  quotedRateGst        String?
  itemNameMerge        String?
  totalValue           String?
  deliverySchedule     String?
  // True once a user picks the value by hand: the sync stops re-deriving it.
  deliveryScheduleOverride Boolean @default(false)
  itemWiseTotalValue   String?
  itemStatus           String?
  availableBomIds      String[] @default([])
  position             Int      @default(0)
  validation           String?
  stockQuantity        String?
  costLogic            String?
  availableStock       String?
  stockAgainstContract String?
  importedInhouse      String?
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch               String?
  // Hidden data carrier. Drives the "Deleted as Current Reqt = No" label and the
  // deleted-status filter beside the item code in the quotation dashboard.
  nBatch               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GmdItemCode {
  id          String   @id @default(cuid())
  itemCode    String // "Code for The Item" column
  itemType    String // ITEM TYPE (col 19)
  moc         String // MOC (col 20)
  operation   String // OPERATION (col 21)
  size        String // SIZE (col 22)
  pnGmd       String // PN-GMD (col 24)
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch      String?
  currentReqt String?
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemType, moc, operation, size, pnGmd])
}

model ExtensionCost {
  id        String   @id @default(cuid())
  length    String   @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BypassCost {
  id        String   @id @default(cuid())
  size      String   @unique
  cost      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTermsCost {
  id        String   @id @default(cuid())
  terms     String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InspectionCost {
  id        String   @id @default(cuid())
  type      String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PbgCost {
  id        String   @id @default(cuid())
  pbg       String   @unique
  costPct   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransportationCost {
  id        String   @id @default(cuid())
  state     String   @unique
  fullLoad  String
  partLoad  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplyHistoryItem {
  id                             String   @id @default(cuid())
  financialYear                  String?
  partyName                      String?
  erpPartyName                   String?
  itemName                       String
  invoiceNo                      String
  date                           String?
  partyOrderNo                   String?
  partyDate                      String?
  quantity                       String?
  uom                            String?
  value                          String?
  grossTotalInvoiceValue         String?
  lrNoDt                         String?
  deliveryDestination            String?
  consigneeAddress               String?
  consigneeName                  String?
  erpContractNo                  String?
  erpItemCode                    String?
  typeOfValve                    String?
  sizeOfValve                    String?
  classOfValve                   String?
  sparesType                     String?
  moc                            String?
  orderCopy                      String?
  invoice                        String?
  inspectionReport               String?
  state                          String?
  utility                        String?
  performanceCertificate         String?
  servicePeriodComplete          String?
  warrantyValidTillAsPerContract String?
  warrantyValidNot               String?
  bgNo                           String?
  pbgValidTill                   String?
  asPerOrderWarrantyPeriod       String?
  pbgClaimTill                   String?
  pbgAmount                      String?
  warrantyExpDateAsPerInv        String?
  partyMailAddress               String?
  orderList                      String?
  derivedItemType                String?
  derivedMoc                     String?
  derivedSize                    String?
  rate                         String?
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch                         String?
  bomLinks SupplyHistoryBomLink[]

selectedBomItemId String?
selectedBomItem BomItem? @relation("SupplyHistorySelectedBomItem", fields: [selectedBomItemId], references: [id])

@@index([selectedBomItemId])
  @@unique([invoiceNo, itemName])
  @@index([erpItemCode])
  syncedAt                       DateTime @default(now())
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

}
model SupplyHistoryBomLink {
  id String @id @default(cuid())

  supplyHistoryItemId String
  supplyHistoryItem SupplyHistoryItem @relation(fields: [supplyHistoryItemId], references: [id])

  bomId String
  bom Bom @relation(fields: [bomId], references: [id])

  bomItemId String
  bomItem BomItem @relation(fields: [bomItemId], references: [id])

  rawMaterialId String?
  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplyHistoryItemId, bomItemId])
  @@index([supplyHistoryItemId])
  @@index([bomId])
  @@index([bomItemId])
  @@index([rawMaterialId])
}

model GMDUpdateItem {
  id                String   @id @default(cuid())
  erpItemCode       String?
  itemNameAuto      String?
  itemNameDerived   String?
  l1                String?
  l2ValveType       String?
  l3Dia             String?
  l7Dimension       String?
  l4Component       String?
  l5Material        String?
  l6Std             String?
  l8ItemCategory    String?
  um                String?
  conv1             String?
  pcsWgt            String?
  aum               String?
  availableStock    String?
  cost              String?
  usdRateOption     String?
  hsnCode           String?
  hsnCodeValidation String?
  conv2             String?
  majorMarking      String?
  newItemStatus     String?
  currentStatus     String?
  rmType            String?
  indianImported    String?
  bomId             String?
  transferred       Boolean  @default(false)
  vendorReference   String?
  // Added by migration 20260831125743_add_availablebomid but was never declared
  // here, so the generated client silently lacked it. Declared to match the DB.
  attachmentUrl     String?
  orderDelivery     String?
  // Hidden data carrier. Drives the "C" chip beside the item code in the UI;
  // never rendered as its own column.
  cBatch            String?
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RawMaterial {
  id                String   @id @default(cuid())
  erpItemCode       String?  @unique
  itemNameAuto      String?
  itemNameDerived   String?
  l1                String?
  l2ValveType       String?
  l3Dia             String?
  l7Dimension       String?
  l4Component       String?
  l5Material        String?
  l6Std             String?
  l8ItemCategory    String?
  um                String?
  conv1             String?
  pcsWgt            String?
  aum               String?
  availableStock    String?
  cost              Decimal?
  usdRateOption     String?
  hsnCode           String?
  hsnCodeValidation String?
  conv2             String?
  majorMarking      String?
  newItemStatus     String?
  currentStatus     String?
  rmType            String?
  indianImported    String?
  transferred       Boolean  @default(false)
  // Set when a Filtered row's NEW ITEM STATUS is cleared to blank/-/Updated and
  // its ITEM NAME (proposed)-AUTO matches an existing New Item: the cost is
  // copied onto that New Item and this flag keeps the source row in Filtered
  // (blank status) instead of shifting it up. Never auto-cleared.
  costMerged        Boolean  @default(false)
  vendorReference   String?
  attachmentUrl     String?
  orderDelivery     String?
  cBatch            String?

  // BOMs where this RawMaterial is used as a component
  bomComponents BomItem[]
  supplyHistoryLinks SupplyHistoryBomLink[]

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PhysicalStock {
  id                             String   @id @default(cuid())
  erp_code                       String?
  location                       String?
  l2_valve_type                  String?
  dimension                      String?
  l7_dimension                   String?
  l4_component                   String?
  l5_material                    String?
  l6_std                         String?
  l8_item_category               String?
  received_qty                   String?
  dispatch_qty                   String?
  available_qty                  String?
  remarks                        String?
  sum_of_physical_stock          String?
  stock_as_per_erp               String?
  rate_unit                      String?
  rate_per_pc_qty_weight         String?
  weight_per_pc                  String?
  item_wise_value                String?
  moving_within_3_months         String?
  order_ag_approval_recvd        String?
  purchase_in_26_27              String?
  dispatched_in_26_27            String?
  order_in_hand_qty              String?
  shortage_qty                   String?
  unnamed_aa                     String?
  item_type                      String?
  price                          String?
  moq                            String?
  if_less_than_moq_extra_charges String?
  drawing_technical_data         String?
  // Derived from the FullItem/RawMaterial BOM relations. `cost` is the highest
  // owning FullItem.cost (DB trigger keeps FullItem.cost = MAX BomItem.cost),
  // falling back to the RawMaterial.cost. `bom_id` is the BOM that carries that
  // highest cost, selected by default and editable via the BOM ID dropdown.
  cost                           String?
  bom_id                         String?
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt

  @@index([erp_code])
}

model FullItem {
  id                   String   @id @default(cuid())
  itemCode             String?  @unique
  itemName             String?
  itemScheduleName     String?
  itemType             String?
  moc                  String?
  operation            String?
  size                 String?
  no                   String?
  pnGmd                String?
  cost                 Decimal?
  currentReqt          String?
  merged               String?
  duplicateMergerCount String?
  bomNature            String?
  consumption1         String?
  consumption2         String?
  consumption3         String?

  // BOMs belonging to this FullItem
  boms Bom[] @relation("FullItemBoms")

  // Where this FullItem itself is used as a BOM component
  bomComponents BomItem[] @relation("FullItemAsComponent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bom {
  id        String   @id @default(cuid())
  bomId     String   @unique
  bomIdType String?
  bomCost   Decimal?

  // The FullItem this BOM belongs to
  fullItemId String
  fullItem   FullItem @relation("FullItemBoms", fields: [fullItemId], references: [id])

  // Materials / FullItems consumed by this BOM
  components BomItem[]
  supplyHistoryLinks SupplyHistoryBomLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullItemId])
}

model BomItem {
  id String @id @default(cuid())

  bomId String
  bom           Bom          @relation(fields: [bomId],references: [id], onDelete: Cascade)

  // If this component is a RawMaterial
  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  // If this component is another FullItem
  fullItemId String?
  fullItem   FullItem? @relation("FullItemAsComponent", fields: [fullItemId], references: [id])

  // Component-specific fields
  quantity Int?
  cost     Decimal?
  noUse    String?
  cBatch   String?
  // Linked by hand from the Raw Material "BOM ID" dropdown. The hourly BOM MAST
  // sync never unlinks these, even when the sheet does not back the pairing.
  manualLink Boolean @default(false)
  supplyHistoryLinks SupplyHistoryBomLink[]

selectedBySupplyHistory SupplyHistoryItem[] @relation("SupplyHistorySelectedBomItem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bomId])
  @@index([rawMaterialId])
  @@index([fullItemId])
}

// Auto BOM rule (/bom/auto). `conditions` is a RuleCondition[] validated by
// ruleSchema in lib/autoBom.ts: which FullItem field is matched against which
// RawMaterial field, plus fixed filters on either side.
model BomRule {
  id         String   @id @default(cuid())
  name       String
  isActive   Boolean  @default(true)
  bomMode    String   @default("PER_MATCH") // "PER_MATCH" | "ALL_IN_ONE"
  bomIdType  String? // BOM type given to created BOMs: "2:1" | "3:1" | "DIRECT M2M" | "CREATE BOM"
  conditions Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model VerifyBom {
  id                   String   @id @default(cuid())
  bomId                String
  itemCode             String
  rmItemCode           String
  bomIdType            String?
  bomItemQty           String?
  noUse                String?
  cBatch               String?
  availableStock       String?
  itemName             String?
  itemScheduleName     String?
  rmItemName           String?
  itemType             String?
  moc                  String?
  operation            String?
  size                 String?
  no                   String?
  pnGmd                String?
  currentReqt          String?
  merged               String?
  duplicateMergerCount String?
  bomNature            String?
  consumption1         String?
  consumption2         String?
  consumption3         String?
  cost                 String?
  bomItemQtyCost       String?
  syncedAt             DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([bomId, itemCode, rmItemCode])
  @@index([itemCode])
}

