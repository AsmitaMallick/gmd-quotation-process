model BisStatus {
  id                String    @id @default(cuid())
  itemName          String?
  bisNo             String    @unique
  expiryDate        DateTime?
  applicationStatus String?
  remark            String?
  reachedLab        String?
  licenseNo         String?
  // Comma-separated Drive links (licence, application, test report, manual).
  bisDocs           String?
  updates           BisStatusUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BisStatusUpdate {
  id          String    @id @default(cuid())
  bisStatusId String
  bisStatus   BisStatus @relation(fields: [bisStatusId], references: [id], onDelete: Cascade)
  status      String?
  nextStep    String?
  nextDate    DateTime?
  remark      String?
  updatedBy   String?
  createdAt   DateTime  @default(now())

  @@index([bisStatusId])
}

model IndentListing {
  id                 String   @id @default(cuid())
  item               String?
  size               String?
  pnRating           String?
  mcReceivedPending  String? // "Received" | "Pending"
  totalBalBillAgCont Float? // summed BAL BILL AG CONT
  v1                 String?
  v2                 String?
  v3                 String?
  v4                 String?
  v1Category         String?
  v2Category         String?
  v3Category         String?
  v4Category         String?
  rmCodeV1           String?
  rmCodeV2           String?
  rmCodeV3           String?
  rmCodeV4           String?
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

