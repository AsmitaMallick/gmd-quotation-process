// ─────────────────────────────────────────────────────────────
// Execution Tracking sync support.
//
// The `GMD_EXECUTION_TRACKING_SPREADSHEET_ID` workbook (the same file as the
// BOM MAST ERP workbook) carries the per-invoice execution rows that the
// `execution-tracking` sync diffs into `SupplyHistoryItem`, plus the
// code -> consignee-name list it joins on.
// ─────────────────────────────────────────────────────────────

/// ACC_MASTER tab -> a local copy of "consignee code -> account name".
///
/// Refreshed hourly by the `acc-master` scheduler job so the
/// `execution-tracking` sync needs no Google call to resolve a consignee name.
/// Codes are unique in the sheet (confirmed with the sheet owner); a duplicate
/// in the sheet is skipped by the sync (first row wins) and counted in its
/// report rather than failing the run.
model AccMaster {
  id        String   @id @default(cuid())
  accCode   String   @unique @map("acc_code")
  accName   String?  @map("acc_name")
  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([syncedAt])
  @@map("acc_master")
}

