model LookupOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type, isActive])
}

model GeneratedImage {
  id            String    @id @default(cuid())
  itemType      String?
  operationType String?
  rmType        String?
  imageKey      String    @unique
  url           String?
  driveFileId   String?
  prompt        String?
  promptVersion String    @default("v1")
  model         String?
  status        String    @default("pending") // pending | generating | ready | failed
  error         String?
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([itemType])
  @@index([operationType])
  @@index([rmType])
  @@index([status])
}

model DocketQuotationThread {
  id            Int       @id @default(autoincrement())
  mysqlThreadId Int?      @map("mysql_thread_id")
  threadId      String    @unique @map("thread_id") @db.VarChar(255)
  mailType      String    @map("mail_type") @db.VarChar(50)
  docketNo      String?   @map("docket_no") @db.VarChar(255)
  docketStatus  String?   @map("docket_status") @db.VarChar(100)
  state         String?   @db.VarChar(100)
  isGmdClient   Boolean   @default(false) @map("is_gmd_client")
  isReplied     Boolean   @default(false) @map("is_replied")
  actionTag     String?   @map("action_tag") @db.VarChar(100)
  matchReasons  String?   @map("match_reasons")
  date          DateTime? @db.Timestamptz(6)
  sender        String?   @db.VarChar(500)
  senderDetails Json?     @map("sender_details")
  toDetails     Json?     @map("to_details")
  ccDetails     Json?     @map("cc_details")
  subject       String?
  body          String?
  bodyPreview   String?   @map("body_preview")
  attachNames   Json?     @map("attach_names")
  attachLinks   Json?     @map("attach_links")
  ocrText       String?   @map("ocr_text")
  aiSummary     String?   @map("ai_summary")
  category      String?   @db.VarChar(100)
  subCategory   String?   @map("sub_category") @db.VarChar(100)
  company       String?   @db.VarChar(100)
  codeword      String?   @db.VarChar(100)
  userLabels    Json?     @map("user_labels")
  pendingDocket Boolean?
  /// AI verdict for the Pending Dockets tab: null = not verified yet,
  /// true = genuine new docket request, false = rejected / already docketed.
  aiIsNewDocket Boolean? @map("ai_is_new_docket")
  /// How many times the model has been called for this thread. Capped at 3;
  /// a true/false verdict is final and is never re-validated.
  aiValidationAttempts  Int     @default(0) @map("ai_validation_attempts")
  /// Last model/database error, shown in the UI once attempts are exhausted.
  aiValidationLastError String? @map("ai_validation_last_error")
  partyName     String?
  /// Frozen fold target: this mail is the same as the docket named here.
  /// The mail ingestion clears docketNo/pendingDocket but never this column,
  /// so docket-creation can skip the thread durably.
  duplicateOfDocket String? 
  msgCount      Int       @default(1) @map("msg_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([threadId], map: "idx_dqt_thread_id")
  @@index([docketNo], map: "idx_dqt_docket_no")
  @@index([docketStatus], map: "idx_dqt_docket_status")
  @@index([isGmdClient], map: "idx_dqt_is_gmd_client")
  @@index([actionTag], map: "idx_dqt_action_tag")
  @@index([mailType], map: "idx_dqt_mail_type")
  @@index([date(sort: Desc)], map: "idx_dqt_date")
  @@index([company], map: "idx_dqt_company")
  @@index([updatedAt(sort: Desc)], map: "idx_dqt_updated_at")
  @@index([pendingDocket], map: "idx_dqt_pending_docket")
  @@index([aiValidationAttempts], map: "idx_dqt_ai_validation_attempts")
  @@map("docket_quotation_threads")
}

model PbgData {
  id            BigInt    @id @default(autoincrement())
  clientName    String?   @map("client_name")
  project       String?
  poNumber      String?   @map("po_number")
  poDate        DateTime? @map("po_date") @db.Date
  bgNo          String?   @map("bg_no")
  bgDate        DateTime? @map("bg_date") @db.Date
  bgAmtFc       Decimal?  @map("bg_amt_fc") @db.Decimal(18, 2)
  expiryDate    DateTime? @map("expiry_date") @db.Date
  claimDate     DateTime? @map("claim_date") @db.Date
  marginPct     Decimal?  @map("margin_pct") @db.Decimal(8, 2)
  marginAmount  Decimal?  @map("margin_amount") @db.Decimal(18, 2)
  contactPerson String?   @map("contact_person")
  contactNumber String?   @map("contact_number")
  remark        String?
  status        String?
  bankGuarantee Json?     @map("bank_guarantee")
  validityOn    String?   @map("validity_on")
  /// Reminder gate: CONTINUE allows the scheduled reminder job to mail this
  /// row; HOLD (or null) never does. Editable from the PBG dashboard only.
  mailTrigger   String?   @default("HOLD") @map("mail_trigger")
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  reminderLogs  PbgReminderLog[]

  @@map("pbg_data")
}

/// One row per reminder send attempt. Pre-expiry sends happen at most once per
/// BG; post-expiry sends repeat every 7 days, so this table is append-only.
model PbgReminderLog {
  id        BigInt   @id @default(autoincrement())
  pbgId     BigInt   @map("pbg_id")
  stage     String   // BEFORE_30_DAYS | EXPIRED
  emails    String
  status    String   // SENT | FAILED
  messageId String?  @map("message_id")
  error     String?
  poNumber     String? @map("po_number")
  recipientKey String? @map("recipient_key")
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  pbg PbgData @relation(fields: [pbgId], references: [id], onDelete: Cascade)

  @@index([pbgId, stage, sentAt], map: "idx_pbg_reminder_pbg_stage_sent")
  @@index([stage, status], map: "idx_pbg_reminder_stage_status")
  @@index([poNumber, recipientKey, stage, sentAt], map: "idx_pbg_reminder_po_recipient_stage_sent")
  @@map("pbg_reminder_log")
}

